# Folder with rules.json, payees.json, and fixtures/. Required.
RULES_DIR=

# Actual Budget server
# Local folder for the downloaded budget. Default ./data.
ACTUAL_BUDGET_DATA_DIR=/app/data
ACTUAL_BUDGET_URL=http://localhost:5006
ACTUAL_BUDGET_PASSWORD=
ACTUAL_BUDGET_SYNC_ID=
# Fallback import account for the poll subcommand only.
ACTUAL_BUDGET_ACCOUNT_ID=

# Gmail OAuth with the read-only scope
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
# Get it with npm run auth:gmail. The bot can rotate it with /auth.
GMAIL_REFRESH_TOKEN=
GMAIL_REDIRECT_URI=http://localhost

# Polling
# Search window in days. Default 3 for the bot, 1 for the poll subcommand.
POLL_LOOKBACK_DAYS=1
# Log the parsed transactions and skip the import. Poll subcommand only.
POLL_DRY_RUN=false
# Log debug lines, including the Actual engine logs.
POLL_DEBUG=false

# Telegram bot
TELEGRAM_BOT_TOKEN=
# The one chat that the bot answers.
TELEGRAM_ALLOWED_CHAT_ID=

# NODE_TLS_REJECT_UNAUTHORIZED=0
